# Copy to .env.local for local work. Never commit real values.
# Test-mode Stripe keys only outside production.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server only; the publishable key is safe for the browser). TEST-MODE KEYS ONLY.
# Live keys are refused unless VERCEL_ENV=production AND STRIPE_LIVE_MODE_APPROVED=yes.
# STRIPE_LIVE_MODE_APPROVED is deliberately not listed here; it is set only on the
# production deployment, after the owner approves going live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Platform fee per charge: percent in basis points (300 = 3%) plus flat cents.
# No defaults on purpose. The app refuses to start payments until both are set.
PLATFORM_FEE_BPS=
PLATFORM_FEE_FIXED_CENTS=

# 32+ random characters each (for example: openssl rand -base64 48)
RATE_LIMIT_SECRET=
CRON_SECRET=

# Email (Resend)
RESEND_API_KEY=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local DB tests only (a throwaway Postgres, never a real project)
TEST_DATABASE_URL=postgres://bybrick_test:bybrick_test@localhost:5432/postgres
