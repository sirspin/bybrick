# Copy to .env.local for local work. Never commit real values.
# Test-mode Stripe keys only outside production.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server only; the publishable key is safe for the browser)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email (Resend)
RESEND_API_KEY=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local DB tests only (a throwaway Postgres, never a real project)
TEST_DATABASE_URL=postgres://bybrick_test:bybrick_test@localhost:5432/postgres
